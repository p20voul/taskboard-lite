# TaskBoard Lite — Environment variables
# Αντίγραψε αυτό το αρχείο σε `.env` στη ρίζα του project και συμπλήρωσε τις τιμές.
# Το `.env` δεν γίνεται commit (είναι στο .gitignore).

# Port για τον Express server (default: 3000)
PORT=3000

# Μυστικό κλειδί για JWT υπογραφή.
# Δημιούργησε ένα ασφαλές 32-byte hex με:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Επιτρεπόμενα CORS origins (comma-separated). Default: * (όλα)
# Π.χ. για production: CORS_ORIGIN=https://myapp.com,https://www.myapp.com
CORS_ORIGIN=*

# Όριο μεγέθους body για JSON requests (default: 100kb)
# Π.χ. BODY_LIMIT=500kb ή BODY_LIMIT=1mb
BODY_LIMIT=100kb
